# 상상톡 웹 서버(Node, web/server.mjs) systemd 유닛 — [웹] 계층, nginx 뒤에서 127.0.0.1:43123만 듣는다.
#
# 설치(root 셸에서):
#   useradd --system --home-dir /nonexistent --shell /usr/sbin/nologin sangsangtalk
#   install -d -o root -g root -m 0755 /opt/sangsangtalk
#   # 반입 패키지의 소스를 푼다. 압축 맨 위의 sangsangtalk-<커밋>/ 폴더를 벗겨 /opt/sangsangtalk 바로 아래에 둔다.
#   tar -xzf source-<커밋>.tar.gz -C /opt/sangsangtalk --strip-components=1
#   install -d -o sangsangtalk -g sangsangtalk -m 0700 /opt/sangsangtalk/web/data
#   install -d -o root -g sangsangtalk -m 0750 /etc/sangsangtalk
#   install -d -o root -g root         -m 0700 /etc/sangsangtalk/tls   # nginx 전용: 웹 인증서·개인키(키 0600 root)
#   install -d -o root -g sangsangtalk -m 0750 /etc/sangsangtalk/ca    # Node가 읽는 기관 루트 CA
#   install -o root -g sangsangtalk -m 0640 eumseong-root-ca.pem /etc/sangsangtalk/ca/eumseong-root-ca.pem
#   install -o root -g sangsangtalk -m 0640 /dev/null /etc/sangsangtalk/web.env   # 아래 예시로 채운다
#   cp /opt/sangsangtalk/ops/systemd/sangsangtalk-web.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now sangsangtalk-web
#   systemctl status sangsangtalk-web ; journalctl -u sangsangtalk-web -f
#
# /etc/sangsangtalk/web.env 예시(KEY=VALUE, 따옴표 없이. SESSION_KEY 비밀값이 들어가므로 0640 root:sangsangtalk):
#   HOST=127.0.0.1
#   PORT=43123
#   PUBLIC_ORIGIN=https://talk.eumseong.local
#   SESSION_KEY=<openssl rand -base64 32 로 만든 32바이트 base64>
#   ZULIP_ORIGIN=https://zulip.eumseong.local
#   ZULIP_CA_FILE=/etc/sangsangtalk/ca/eumseong-root-ca.pem
#   MAX_UPLOAD_MB=100
#   # ZULIP_TLS_INSECURE=1 은 개발용. 운영에서는 쓰지 않는다.
#   # --- 2단계(docs/p2-contract.md). 줄을 빼면 기본값. 범위를 벗어난 값은 설정 오류로 서버가 시작하지 않는다 ---
#   # 감사 로그 보존 개월 수(1~120, 기본 12). web/data/audit/YYYY-MM.jsonl 중 지난 것은 서버가 시작할 때 지운다.
#   AUDIT_KEEP_MONTHS=12
#   # 대화창 워터마크(이름·로그인ID 앞부분·날짜). 정확히 0이면 끔, 그 밖의 값·없음은 켬(기본 켬).
#   WATERMARK=1
#   # 입력이 없는 채로 이 분(0~1440)이 지나면 잠금 화면. 0이면 끔(기본 30).
#   AUTO_LOCK_MINUTES=30
#   # CMS에서 직원을 만들 때 로그인 ID(사번@도메인)에 붙일 내부 도메인. 비우면 관리자 본인 이메일의 도메인.
#   # 점이 있는 도메인 이름만(예: eumseong.local). "@"를 붙이거나 잘못된 값이면 서버가 시작하지 않는다.
#   LOGIN_DOMAIN=
#   # --- 3단계(docs/p3-contract.md): 새 변수 없음. 관리자 정책은 web/data/policy.json(관리자 화면 "정책" 탭)에 있고,
#   #     업로드 최대 크기는 계속 MAX_UPLOAD_MB, 기관 자동 잠금 값은 계속 AUTO_LOCK_MINUTES 다.
#
# 주의:
#   - Node는 OS 인증서 저장소가 아니라 자체 CA 목록을 쓴다. 기관 내부 CA로 발급한 Zulip 인증서를 검증하려면
#     ZULIP_CA_FILE(권장) 또는 NODE_EXTRA_CA_CERTS=/etc/sangsangtalk/ca/eumseong-root-ca.pem 으로 CA를 준다.
#     CA는 /etc/sangsangtalk/ca/(0750 root:sangsangtalk, 파일 0640)에 둔다. /etc/sangsangtalk/tls/(nginx 개인키)는 이 계정이 못 읽는다.
#   - 설정 오류(잘못된 HOST·PORT·PUBLIC_ORIGIN·ZULIP_ORIGIN·ZULIP_CA_FILE·SESSION_KEY)면 서버가 한국어 오류를 남기고
#     종료 코드 1로 끝난다. 실행 중 예외로 죽어도 1이므로 RestartPreventExitStatus 대신 시작 횟수 제한을 쓴다:
#     60초 안에 5번 시작하면 더 이상 재시작하지 않고 failed가 된다. 고친 뒤 `systemctl reset-failed sangsangtalk-web` 후 시작.
#   - 포트 43123을 바꾸면 ops/nginx/sangsangtalk.conf 의 upstream 도 함께 바꾼다.
#   - MAX_UPLOAD_MB를 바꾸면 nginx 의 /api/files client_max_body_size 도 함께 바꾼다.
#   - 중요 메시지 시간당 10회 제한은 이 프로세스 메모리에만 있어 재시작하면 초기화된다(ops/README.md "3단계 운영 반영" 3절).
#   - web/data/policy.json 과 .bak 을 둘 다 읽지 못하면 서버는 돌지만 파일 올리기가 503으로 막힌다(ops/restore.md).
#   - Node 24 공식 tarball을 /opt/node 에 설치한 경로(/opt/node/bin/node)를 쓴다(ops/rocky9.md).
#     다른 곳에 설치했으면 ExecStart를 고친다(`command -v node`). Node 24 기준으로 개발했다.

[Unit]
Description=SangsangTalk web server (Zulip proxy)
Documentation=file:///opt/sangsangtalk/ops/README.md
After=network-online.target
Wants=network-online.target
# 설정 오류로 바로 죽는 경우 무한 재시작하지 않게: 60초 안에 5번 시작하면 멈춘다(RestartSec=5s와 함께).
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=sangsangtalk
Group=sangsangtalk
WorkingDirectory=/opt/sangsangtalk/web
EnvironmentFile=/etc/sangsangtalk/web.env
Environment=NODE_ENV=production
ExecStart=/opt/node/bin/node /opt/sangsangtalk/web/server.mjs
Restart=on-failure
RestartSec=5s
# 롱폴링(/api/events) 연결이 끊길 때까지 기다리지 않도록 종료 대기 시간을 짧게
TimeoutStopSec=15s
UMask=0077

# --- 하드닝 ---
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
# 쓰기는 web/data 만(쪽지 인덱스·세션 파일, 2단계의 notices·prefs·admin-meta·audit/, 3단계의 activity·policy)
ReadWritePaths=/opt/sangsangtalk/web/data
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
# 허용 목록 밖 시스템 호출은 프로세스를 죽이지 않고 EPERM으로 돌려준다
SystemCallErrorNumber=EPERM
# MemoryDenyWriteExecute=yes 는 V8 JIT와 충돌하므로 쓰지 않는다.

[Install]
WantedBy=multi-user.target
