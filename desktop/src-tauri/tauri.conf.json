{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SangsangTalk",
  "version": "0.1.0",
  "identifier": "com.sangsangtalk.desktop",
  "build": {
    "frontendDist": "../ui",
    "devUrl": "http://127.0.0.1:43123/"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": null
    },
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "publisher": "SangsangTalk",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
