ZULIP__POSTGRES_PASSWORD=
ZULIP__MEMCACHED_PASSWORD=
ZULIP__RABBITMQ_PASSWORD=
ZULIP__REDIS_PASSWORD=
ZULIP__SECRET_KEY=
ZULIP__EMAIL_PASSWORD=
# Local Zulip test logins. Local-only; not for production.
ZULIP_ORG_NAME=
ZULIP_ORG_URL=
ZULIP_TEST1_EMAIL=
ZULIP_TEST1_PASSWORD=
ZULIP_TEST1_FULL_NAME=
ZULIP_TEST2_EMAIL=
ZULIP_TEST2_PASSWORD=
ZULIP_TEST2_FULL_NAME=
ZULIP_GIMSANGSANG_EMAIL=
ZULIP_GIMSANGSANG_PASSWORD=
ZULIP_GIMSANGSANG_FULL_NAME=
ZULIP_HONGGILDONG_EMAIL=
ZULIP_HONGGILDONG_PASSWORD=
ZULIP_HONGGILDONG_FULL_NAME=
ZULIP_JEONSANI_EMAIL=
ZULIP_JEONSANI_PASSWORD=
ZULIP_JEONSANI_FULL_NAME=
ZULIP_TONGSINI_EMAIL=
ZULIP_TONGSINI_PASSWORD=
ZULIP_TONGSINI_FULL_NAME=
ZULIP_GWANJENAM_EMAIL=
ZULIP_GWANJENAM_PASSWORD=
ZULIP_GWANJENAM_FULL_NAME=
ZULIP_CHANNEL_NAME=
# web/server.mjs upload limit in MB, read from the server PROCESS environment (server.mjs does not load .env;
# set it in the shell or service that starts the server). Empty = 100. Zulip's own MAX_FILE_UPLOAD_SIZE (100) also applies.
MAX_UPLOAD_MB=
# ---- web/server.mjs, closed-network deployment (docs/migration-prep.md M2-M4). Read from the server
# PROCESS environment (e.g. systemd EnvironmentFile); server.mjs does not load .env. Empty = development default.
# Addresses to listen on, comma-separated. Empty = 127.0.0.1,::1 (loopback; nginx in front). 0.0.0.0 is accepted.
HOST=
# Public address the browser uses, e.g. https://talk.eumseong.local (no path). When set, POST/PATCH/DELETE
# must carry exactly this Origin, and an https value adds Secure to the session cookie. Empty = Host-header check.
PUBLIC_ORIGIN=
# 32-byte base64 key for the encrypted session file web/data/sessions.json (logins survive restarts).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Empty = sessions in memory only; a malformed value stops the server. Changing it signs everyone out.
# Run one server process per sessions.json: two processes sharing the file (e.g. a dev copy) overwrite each other.
SESSION_KEY=
# PEM file of the CA that signed Zulip's HTTPS certificate (internal CA). Set = verify against it.
ZULIP_CA_FILE=
# 1 = do not verify Zulip's certificate (development only). If neither is set, verification is off only for
# the default development Zulip (localhost.localdomain) and on for any other ZULIP_ORIGIN.
ZULIP_TLS_INSECURE=
# ---- Docker compose variables (docs/migration-prep.md M5). Read by compose from .env (or --env-file).
# compose.yaml (development all-in-one): empty = localhost.localdomain:9991 and host port 9991.
# ops/compose/compose.app.yaml (closed-network [app] tier): ZULIP_EXTERNAL_HOST is required, e.g. zulip.eumseong.local
# (the name the web server's ZULIP_ORIGIN uses); empty ZULIP_HTTPS_PORT = 443.
ZULIP_EXTERNAL_HOST=
ZULIP_HTTPS_PORT=
# ops/compose/compose.app.yaml only (required there): Zulip administrator email, DB server address. ZULIP_DB_PORT empty = 5432.
ZULIP_ADMINISTRATOR=
ZULIP_DB_HOST=
ZULIP_DB_PORT=
# ops/compose/compose.app.yaml only (required there): this app server's internal IP that Zulip's HTTPS port is
# published on, e.g. 10.0.20.10 (the NIC the web server and admin PC reach). Not 0.0.0.0.
ZULIP_APP_BIND_ADDRESS=
# ops/compose/compose.db.yaml only (required there): this DB server's internal IP that PostgreSQL 5432 is
# published on, e.g. 10.0.30.10 (the NIC the app server reaches). Not 0.0.0.0. Also allow only the app server in the firewall.
ZULIP_DB_BIND_ADDRESS=
